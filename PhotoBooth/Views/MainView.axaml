<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PhotoBooth.ViewModels"
             xmlns:conv="clr-namespace:PhotoBooth.Converters;assembly=PhotoBooth"
             mc:Ignorable="d"
             x:Class="PhotoBooth.Views.MainView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <conv:ByteArrayToBitmapConverter x:Key="ByteArrayToBitmapConverter"/>
  </UserControl.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <!-- Preview -->
      <RowDefinition Height="Auto" />
      <!-- Controls -->
    </Grid.RowDefinitions>

    <!-- Camera Preview mit Fotoalbum Overlay -->
    <Grid Grid.Row="0">
      <Border CornerRadius="20" Background="#222" Padding="10">
        <Image Source="{Binding PreviewImage, Converter={StaticResource ByteArrayToBitmapConverter}}"
               Stretch="Uniform"/>
      </Border>

      <!-- Fotoalbum Thumbnail -->
      <Border Width="100" Height="100" CornerRadius="10"
              Background="#333" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="10" Cursor="Hand">
        <Image Source="{Binding LastCapturedPhoto, Converter={StaticResource ByteArrayToBitmapConverter}}"
               Stretch="UniformToFill"/>
      </Border>
    </Grid>

    <!-- Timer + Foto Button -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
      <Button Content="−" Width="60" Height="60" FontSize="24" Command="{Binding DecreaseTimerCommand}" />
      <TextBlock Text="{Binding TimerSeconds}" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <Button Content="+" Width="60" Height="60" FontSize="24" Command="{Binding IncreaseTimerCommand}" />

      <!-- Foto Button -->
      <Button Content="Foto starten" Width="200" Height="60" FontSize="24" Command="{Binding StartPhotoCommand}" Margin="20,0,0,0"/>
    </StackPanel>

  </Grid>
</UserControl>
